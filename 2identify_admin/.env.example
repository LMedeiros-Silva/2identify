# Comunicação do desktop Admin com a API
API_URL=http://127.0.0.1:8000
API_CONNECT_TIMEOUT_SECONDS=3
API_READ_TIMEOUT_SECONDS=8
API_WRITE_TIMEOUT_SECONDS=8
API_POOL_TIMEOUT_SECONDS=3

# Captura para configurar áreas de risco: use o ID real do cadastro.
# CAMERA_SOURCE_5="rtsp://USUARIO:SENHA@camera.example:554/caminho"
# Para USB, o valor é o índice nesta estação, ex.: CAMERA_SOURCE_5=0.
# Sem vínculo aqui, o Admin consulta ../2identify_operador/.env pelo mesmo ID.
# Credenciais ficam somente no .env local, nunca no cadastro ou em logs.

# Observabilidade local (nunca registre senhas ou tokens)
LOG_LEVEL=INFO
# LOG_DIRECTORY=C:\caminho\para\logs

# Ferramentas legadas de banco (Alembic e seed.py); não usadas pelo login/dashboard
DATABASE_URL=
ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_PASSWORD=defina-um-segredo-forte-de-no-minimo-12-caracteres
