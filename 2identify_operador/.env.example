# Copie este arquivo para .env e ajuste-o para cada instalação.
APP_ENVIRONMENT=development
API_URL=http://localhost:8000
API_CONNECT_TIMEOUT_SECONDS=3
API_READ_TIMEOUT_SECONDS=10
# Fonte local temporária, permitida somente em development/testing.
OPERATIONS_MOCK_ENABLED=true
PPE_MODEL_PATH=models/ppe/best.pt
PPE_MODEL_SHA256=73A87F86E68F7C5091857F48B55BB756A70B88D0217CC35C58EED3969C7EBA20
PPE_CONFIDENCE_THRESHOLD=0.50
PPE_IOU_THRESHOLD=0.45
PPE_INFERENCE_IMAGE_SIZE=640
PPE_INFERENCE_FPS=4
PPE_INFERENCE_DEVICE=cpu
PPE_STABILITY_WINDOW_FRAMES=8
PPE_STABILITY_MINIMUM_FRAMES=5
PPE_STABILITY_PRESENT_RATIO=0.75
PPE_STABILITY_ABSENT_RATIO=0.25
PPE_RELEASE_ASSESSMENT_MAX_AGE_SECONDS=2
PPE_TRACKING_IOU_THRESHOLD=0.30
PPE_TRACKING_MAXIMUM_MISSED_BATCHES=3
PPE_TRACKING_MINIMUM_CONFIRMATION_HITS=2
ALERT_MINIMUM_CONSECUTIVE_OBSERVATIONS=3
ALERT_MINIMUM_PERSISTENCE_SECONDS=0.75
ALERT_RESOLUTION_CONSECUTIVE_OBSERVATIONS=3
ALERT_COOLDOWN_SECONDS=30
ULTRALYTICS_CONFIG_DIRECTORY=var/ultralytics
MANUALS_DIRECTORY=assets/manuals
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_OPEN_TIMEOUT_MS=5000
CAMERA_READ_TIMEOUT_MS=2000
CAMERA_MAX_FAILED_READS=30
CAMERA_PREVIEW_FPS=20
LOGIN_CAMERA_SOURCE=0
FACE_AUTH_ENABLED=true
FACE_AUTH_TIMEOUT_SECONDS=15
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
FACE_AUTH_TEMPLATE_STORE_PATH=var/face_auth/operators.json
FACE_AUTH_MODEL_ID=opencv_sface_2021dec
FACE_AUTH_CONFIDENCE_THRESHOLD=0.50
FACE_AUTH_DETECTION_THRESHOLD=0.90
FACE_AUTH_INFERENCE_FPS=8
FACE_AUTH_PREVIEW_FPS=20
FACE_AUTH_MIN_CONSECUTIVE_MATCHES=3
FACE_AUTH_MIN_FACE_RATIO=0.18
FACE_AUTH_LIVENESS_REQUIRED=true
FACE_AUTH_LIVENESS_MIN_DURATION_SECONDS=0.8
FACE_AUTH_LIVENESS_MIN_MOVEMENT_RATIO=0.045
# Permitido somente em development/testing; produção deverá autorizar pela API.
FACE_AUTH_ALLOW_LOCAL_AUTHORIZATION=true
LOGIN_CAMERA_WIDTH=1280
LOGIN_CAMERA_HEIGHT=720
LOGIN_CAMERA_OPEN_TIMEOUT_MS=5000
LOGIN_CAMERA_READ_TIMEOUT_MS=2000
LOGIN_CAMERA_MAX_FAILED_READS=30
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIRECTORY=logs
