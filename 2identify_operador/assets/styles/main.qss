QMainWindow#mainWindow,
QWidget#mainRoot,
QWidget#mainWorkspace {
  background-color: {{surface_0}};
}

QFrame#mainHeader {
  background-color: {{surface_1}};
  border: none;
  border-bottom: 1px solid {{line_200}};
}

QLabel#mainPageContext {
  color: {{brand_600}};
  font-size: {{font_badge}};
  font-weight: 700;
  letter-spacing: 1px;
}

QLabel#mainPageTitle {
  color: {{ink_900}};
  font-size: {{font_section}};
  font-weight: 700;
}

QLabel#mainSessionBadge {
  color: {{safe_700}};
  background-color: {{safe_50}};
  border: 1px solid {{safe_300}};
  border-radius: 13px;
  padding: 0 12px;
  font-size: {{font_label}};
  font-weight: 700;
  letter-spacing: 1px;
}

QFrame#mainHeaderDivider {
  background-color: {{line_200}};
  border: none;
}

QLabel#mainOperatorAvatar {
  color: {{surface_1}};
  background-color: {{nav_800}};
  border-radius: 18px;
  font-size: {{font_small}};
  font-weight: 800;
}

QLabel#mainOperatorName {
  color: {{ink_900}};
  font-size: {{font_small}};
  font-weight: 700;
}

QLabel#mainOperatorDetail {
  color: {{ink_500}};
  font-size: {{font_label}};
}

QStackedWidget#mainPageStack {
  background-color: {{surface_0}};
  border: none;
}
