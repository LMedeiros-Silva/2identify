DATABASE_URL=postgresql+psycopg2://identify_user:CHANGE_ME@localhost:5432/identify_db
APP_NAME=2Identify API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_SCHEMA=public
DATABASE_CONNECT_TIMEOUT_SECONDS=3
AUTH_TOKEN_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TOKEN_TTL_MINUTES=30
AUTH_TOKEN_ISSUER=2identify-api
AUTH_TOKEN_AUDIENCE=2identify-operator
AUTH_ADMIN_TOKEN_AUDIENCE=2identify-admin
AUTH_ALLOWED_PROFILES=operador
# Gere um token aleatório e use o mesmo no 2identify_operador.
OPERATOR_CATALOG_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Face ID: token da estação Operator (outro valor aleatório, o mesmo no 2identify_operador).
# A API compara o rosto com os templates cadastrados no Admin e emite a sessão do funcionário.
OPERATOR_STATION_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FACE_AUTH_SIMILARITY_THRESHOLD=0.50
FACE_AUTH_AMBIGUITY_MARGIN=0.05
FACE_AUTH_MIN_PROBES=3
REALTIME_HEARTBEAT_INTERVAL_SECONDS=20
REALTIME_CLIENT_QUEUE_CAPACITY=64
REALTIME_MAX_CONNECTIONS=128
REALTIME_MAX_CONNECTIONS_PER_ADMIN=4
REALTIME_SINK_CLOSE_TIMEOUT_SECONDS=2
# Gere um token aleatório com pelo menos 32 caracteres e use o mesmo no ESP32.
SAFETY_DEVICE_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SAFETY_DEVICE_MAX_CONNECTIONS=8
# Painel público (2identify_web): processo separado, somente leitura, sem login.
# Rode com: python -m scripts.run_public_panel --host 0.0.0.0 --port 8100
# Endereço público que vai no QR Code (link do túnel ou http://IP-da-rede:8100).
# Vazio = usa o endereço em que a página /qr foi aberta.
PUBLIC_PANEL_URL=
PUBLIC_PANEL_POLL_SECONDS=1
# O painel usa o mesmo DATABASE_URL, com todas as transações em modo somente leitura.
